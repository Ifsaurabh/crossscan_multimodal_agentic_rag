# DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT below are NOT read by any code (db.py uses only
# DATABASE_URL) - left here only because older docs mention them. Safe to ignore/delete.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Postgres (pgvector) ---
# Local dev: postgresql://<user>:<password>@localhost:5432/<dbname>
# Deployed (Neon free tier): the connection string Neon gives you after creating a project -
# looks like postgresql://<user>:<password>@ep-xxxx-xxxx.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=
SCHEMA_NAME=rag_new
# Connection pool used by the running app (chat UI / API). Optional; defaults shown. Each running
# question can hold 2 connections, so keep DB_POOL_MAX >= 2 x MAX_CONCURRENT_REQUESTS.
# DB_POOL_MIN=2
# DB_POOL_MAX=8
# DB_POOL_TIMEOUT=15

# --- Hugging Face (Llama Prompt Guard 2, the prompt-injection flagger) ---
# The model is GATED: accept Meta's licence on its Hugging Face page, then create a read token at
# huggingface.co/settings/tokens. Without it the app still runs, with injection flagging switched off.
# Also needed as the HF_TOKEN GitHub repository secret (the image build bakes the model in).
HF_TOKEN=

# --- Gemini (LLM + used by GEMINI_API_KEY below across all 3 model tiers) ---
GEMINI_API_KEY=

# --- Admin account ---
# Read at startup (Streamlit and the API): this account is created if missing, and every start it is
# forced to role admin + active and its password is re-synced to the value here. The admin has NO
# usage limits of any kind. Leave both empty to skip. Password: 8+ characters. Never printed/logged.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Langfuse (tracing + prompt sync) ---
# LANGFUSE_DISABLED=1 turns tracing off entirely - safe default while nothing is running.
# Local self-hosted (see langfuse/): keys are in langfuse/.env as LANGFUSE_INIT_PROJECT_*,
#   LANGFUSE_HOST=http://localhost:3000
# Langfuse Cloud (free Hobby plan, no self-hosting needed - better fit once deployed):
#   sign up at cloud.langfuse.com, create a project, get PUBLIC/SECRET keys from its settings,
#   LANGFUSE_HOST=https://cloud.langfuse.com (or https://us.cloud.langfuse.com for the US region)
# Whichever you use, delete/comment out LANGFUSE_DISABLED below once these 3 are filled in.
LANGFUSE_DISABLED=1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

TEXT_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32

TOP_K=4

# --- LLM providers (src/llm_connection.py) ---
# Only API KEYS live here. The three model tiers (fast / reasoning / evaluation), their models
# and the fallbacks are settings at the top of src/llm_connection.py. Right now every tier uses
# Google Gemini models only, so only GEMINI_API_KEY (defined above) is needed. To move a tier to
# another vendor later, edit TIERS in llm_connection.py and add that vendor's key here:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Access control, quotas and limits (all optional; defaults shown) ---
# Login token lifetime in hours
AUTH_TOKEN_TTL_HOURS=24
# Self-service sign-up (POST /auth/register and the UI tab). ON by default (open sign-up);
# set to 0 so only an admin can create accounts.
ALLOW_REGISTRATION=1
# Max accounts created per day, service-wide (open sign-up lets one person make many accounts).
# Every daily counter resets at midnight India time (IST).
REGISTRATIONS_PER_DAY=10
# Daily quota per role (messages / tokens); override per user with manage_users.py set-limits.
# Signed-in users get 6 messages/day for now. Raise later as needed.
# The admin account (ADMIN_USERNAME / ADMIN_PASSWORD above) has NO limits of any kind.
USER_DAILY_REQUEST_LIMIT=6
USER_DAILY_TOKEN_LIMIT=200000
# Hard per-user ceiling per minute (kept in Postgres, so it holds across Cloud Run instances)
RATE_LIMIT_PER_MINUTE=2
# Total messages per day across ALL users. A limit is mandatory, so this is ON by default (100).
# One message is ~3-4 Gemini calls: on the free tier (20 calls/day) use ~5. Raise it when you add
# credits or another LLM. 0 disables the cap.
GLOBAL_DAILY_REQUEST_CAP=100
# How many DIFFERENT users may be served per day (default 10; with 6 messages each = 60 requests,
# inside the cap above). Someone already served today is never cut off; only a new user is refused
# once it is full. Admins are exempt. 0 disables.
DAILY_ACTIVE_USER_CAP=10
# How many questions may be processed at the SAME moment (default 3). When all slots are busy the
# user sees "busy, try again in a few seconds"; the refused question costs nothing (the per-minute
# slot it took is given back). Per instance (the database pool it protects is per instance). 0 disables.
MAX_CONCURRENT_REQUESTS=3
# Online evaluation: the share of REAL answers judged by DeepEval (faithfulness + answer relevancy)
# on the evaluation-tier models, in a background thread, never charged to the user. Each judged answer
# costs several model calls, so keep it low on the free tier. 0 turns it off. Default 0.1 (10%).
ONLINE_EVAL_SAMPLE_RATE=0.1
# Optional USD per million tokens, for cost estimates (0 = free tier)
GEMINI_PRICE_PER_M_INPUT=0
GEMINI_PRICE_PER_M_OUTPUT=0

# --- Ingestion worker, figures and tools (all optional; on Cloud Run most are set by the deploy workflow) ---
# The documents bucket and the queue the worker reads (the app reads figures from the same bucket)
# DOCS_BUCKET=crossscan-docs-upload-here
# DOCS_SUBSCRIPTION=doc-events-sub
# The schema the app and the worker read (default rag_new; the rebuilt data is rag_v2)
# SCHEMA_NAME=rag_v2
# Google project id (the trigger function and the worker; found from the credentials when not set)
# GOOGLE_CLOUD_PROJECT=your-project-id
# Development only: read figures from a local folder instead of the bucket (<folder>/<domain>/<paper>/page3_img1.png)
# IMAGES_LOCAL_DIR=
# Tesseract OCR: the command (found on the PATH or in the per-user Windows install when unset) and its language data
# TESSERACT_CMD=
# TESSDATA_PREFIX=
# 0 runs the searches of a question one after another (to measure the parallel retrieval before and after). Default on.
# RETRIEVAL_PARALLEL=1

# --- MLflow shared store (see .github/MLFLOW_SETUP.md). Unset = a local ./mlruns folder ---
# MLFLOW_STORE=database
# MLFLOW_ARTIFACT_ROOT=gs://crossscan-docs-upload-here/mlflow
# MLFLOW_TRACKING_URI=
