venv-rag-new/
__pycache__/
*.pyc
.pytest_cache/
.git/
.dvc/
.env
mlruns/
# Heavy, ingestion-only subfolders - not needed at runtime. NOT excluding data/ itself: Docker
# can't reliably un-ignore a nested path (e.g. data/images) once its parent is excluded, so this
# lists exactly what to skip instead of excluding the whole folder and trying to negate one part.
data/raw/
data/text/
data/prepared/
data/guarded/
data/chunks/
data/embeddings/
langfuse/
tests/
*.md
# Never needed in the image (and screenshots / notebooks can contain real questions and data)
.github/
screenshots/
reports/
.deepeval/
*.ipynb
